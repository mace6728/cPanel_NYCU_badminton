# Turn on the rewrite engine
RewriteEngine on

# Set the default index file
DirectoryIndex index.php

# SECURITY: Disable folder directory listings to protect your files
Options -Indexes

# Redirect HTTP to HTTPS (with SSL renewal exclusions)
RewriteCond %{SERVER_PORT} 80
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^(.*)$ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

# Directories with no index file answer 404 instead of 403, so the scanner (and
# anyone else) can't use the difference to discover css/, img/, js/, gallery/...
# The root and /admin (Basic Auth answers first) are excluded.
RewriteCond %{REQUEST_URI} !^/(admin|\.well-known)(/|$)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^.+ - [R=404,L]


# ---------------------------------------------------------------------------
# Security headers (needs mod_headers; silently skipped if it is missing)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS: browsers refuse plain HTTP. Only sent over HTTPS. The value matches
    # what the university's front end already sends (157680000 = 5 years), so a
    # response carrying both is still consistent. No includeSubDomains/preload:
    # the parent nycu.edu.tw zone isn't ours.
    Header always set Strict-Transport-Security "max-age=157680000" env=HTTPS

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # No X-Frame-Options here: the front end already sends it (twice), and the
    # CSP below carries frame-ancestors, which supersedes it.

    # CSP. Pages still use inline <script>/style="" so 'unsafe-inline' is needed
    # for scripts and styles until those are moved into files. Everything else is
    # locked down: no plugins, no <base> hijack, forms only post back to us, and
    # only we may frame the site. Google Fonts is the only third-party origin
    # (the per-page css files import Noto Sans TC from it); img/frame are open to
    # https because articles may embed outside photos and videos.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; frame-src https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

    # Catch-all for cookies: add whatever attribute a Set-Cookie is missing
    # (PHP sessions, or anything else that sets one). The negative lookahead
    # makes each rule a no-op when the attribute is already there.
    Header edit Set-Cookie "(?i)^((?:(?!;\s?httponly).)+)$" "$1; HttpOnly"
    Header edit Set-Cookie "(?i)^((?:(?!;\s?secure).)+)$" "$1; Secure"
    Header edit Set-Cookie "(?i)^((?:(?!;\s?samesite).)+)$" "$1; SameSite=Lax"
    Header always edit Set-Cookie "(?i)^((?:(?!;\s?httponly).)+)$" "$1; HttpOnly"
    Header always edit Set-Cookie "(?i)^((?:(?!;\s?secure).)+)$" "$1; Secure"
    Header always edit Set-Cookie "(?i)^((?:(?!;\s?samesite).)+)$" "$1; SameSite=Lax"
</IfModule>

# Per-directory PHP settings must never be downloadable.
<Files ".user.ini">
    Require all denied
</Files>
